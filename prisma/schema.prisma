// Modelo de datos del Portal MPM.
// Ver docs/DATA_MODEL.md para el diagrama y la justificación de cada decisión.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Usuarios y roles
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SALES
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role      @default(SALES)
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  assignedRequests    CartRequest[]      @relation("AssignedSalesRep")
  handledCartSessions CartSession[]      @relation("HandledCartSession")
  events              CartRequestEvent[] @relation("EventAuthor")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Catálogo: categorías, productos, imágenes
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products           Product[]
  priorityInCampaign Campaign[] @relation("CampaignPriorityCategories")

  @@index([parentId])
}

enum ProductStatus {
  DISPONIBLE
  BAJO_PEDIDO
  AGOTADO
  OCULTO
}

enum ProductTagType {
  OFERTA
  TENDENCIA
  NUEVO
  RECOMENDADO
}

enum Audience {
  HOMBRE
  MUJER
  NINO
  NINA
  UNISEX
}

model Product {
  id          String           @id @default(cuid())
  sku         String           @unique
  name        String
  slug        String           @unique
  description String
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  audience    Audience         @default(UNISEX)
  sizes       String[]
  colors      String[]
  material    String?
  status      ProductStatus    @default(DISPONIBLE)
  tags        ProductTagType[]
  campaignId  String?
  campaign    Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  priceRef    Decimal?         @db.Decimal(12, 2)

  viewCount      Int @default(0)
  addToCartCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images           ProductImage[]
  cartSessionItems CartSessionItem[]
  cartRequestItems CartRequestItem[]

  @@index([categoryId])
  @@index([campaignId])
  @@index([status])
  @@index([audience])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  // Color al que pertenece esta foto (ej. "AGUA"), cuando se puede inferir
  // con seguridad desde el nombre del archivo entregado por MPM.
  color     String?
  order     Int      @default(0)
  publicId  String?
  createdAt DateTime @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Campañas temáticas
// ---------------------------------------------------------------------------

model Campaign {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?
  bannerImageUrl String?
  colorPrimary   String?
  colorSecondary String?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products           Product[]
  priorityCategories Category[] @relation("CampaignPriorityCategories")

  @@index([isActive])
}

enum SeasonalThemeMode {
  AUTOMATIC
  MANUAL
  OFF
}

enum SeasonalThemePreset {
  DEFAULT
  NEGROS_Y_BLANCOS
  CARNAVAL
  SAN_PEDRO
  COLOMBIA
  AMOR_Y_AMISTAD
  VELITAS
  NAVIDAD
}

// ---------------------------------------------------------------------------
// Configuración del sitio (identidad provisional, contacto, textos editables)
// ---------------------------------------------------------------------------

model SiteSettings {
  id                     String              @id @default("default")
  siteName               String              @default("MPM")
  tagline                String              @default("Ropa hecha para acompañar tu día a día")
  logoUrl                String?
  primaryColor           String              @default("#1F4D3D")
  secondaryColor         String              @default("#D9A441")
  accentColor            String              @default("#F4EFE7")
  whatsappNumber         String              @default("573000000000")
  whatsappDefaultMessage String              @default("Hola MPM, quiero más información sobre sus prendas.")
  contactEmail           String?
  contactPhone           String?
  address                String?
  instagramUrl           String?
  facebookUrl            String?
  tiktokUrl              String?
  heroTitle              String              @default("Prendas que se sienten bien")
  heroSubtitle           String              @default("Encuentra referencias para tu negocio, tu equipo o tu día a día. Te asesoramos para elegir.")
  heroImageUrl           String?
  heroCtaLabel           String              @default("Ver catálogo")
  heroCtaHref            String              @default("/catalogo")
  footerText             String              @default("MPM Fábrica de ropa. Atención comercial personalizada.")
  dataPolicyText         String?
  showPrices             Boolean             @default(false)
  seasonalThemeMode      SeasonalThemeMode   @default(AUTOMATIC)
  seasonalThemePreset    SeasonalThemePreset @default(DEFAULT)
  updatedAt              DateTime            @updatedAt
}

// ---------------------------------------------------------------------------
// Carrito (sin pagos) y seguimiento comercial
// ---------------------------------------------------------------------------

model CartSession {
  id                  String             @id @default(cuid())
  sessionToken        String             @unique
  contactNamePartial  String?
  contactPhonePartial String?
  // Estado comercial que asigna el equipo al recuperar un carrito. Null
  // significa que se muestra su estado automático: activo o abandonado.
  commercialStatus    CartRequestStatus?
  handledById         String?
  handledBy           User?              @relation("HandledCartSession", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  items            CartSessionItem[]
  convertedRequest CartRequest?

  @@index([updatedAt])
  @@index([commercialStatus])
  @@index([handledById])
}

model CartSessionItem {
  id                  String      @id @default(cuid())
  cartSessionId       String
  cartSession         CartSession @relation(fields: [cartSessionId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  productSkuSnapshot  String
  size                String?
  color               String?
  quantity            Int         @default(1)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([cartSessionId])
}

enum CartRequestStatus {
  NUEVO
  CONTACTADO
  EN_NEGOCIACION
  VENDIDO
  CERRADO
  CANCELADO
}

model CartRequest {
  id            String       @id @default(cuid())
  cartSessionId String?      @unique
  cartSession   CartSession? @relation(fields: [cartSessionId], references: [id], onDelete: SetNull)

  contactName  String
  contactPhone String
  city         String
  companyName  String?
  comment      String?
  dataConsent  Boolean   @default(false)
  consentedAt  DateTime?

  status       CartRequestStatus @default(NUEVO)
  assignedToId String?
  assignedTo   User?             @relation("AssignedSalesRep", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  CartRequestItem[]
  events CartRequestEvent[]

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model CartRequestItem {
  id                  String      @id @default(cuid())
  cartRequestId       String
  cartRequest         CartRequest @relation(fields: [cartRequestId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  productSkuSnapshot  String
  size                String?
  color               String?
  quantity            Int         @default(1)
  priceRefSnapshot    Decimal?    @db.Decimal(12, 2)

  @@index([cartRequestId])
}

enum CartRequestEventType {
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  CREATED
}

model CartRequestEvent {
  id             String               @id @default(cuid())
  cartRequestId  String
  cartRequest    CartRequest          @relation(fields: [cartRequestId], references: [id], onDelete: Cascade)
  type           CartRequestEventType
  note           String?
  previousStatus CartRequestStatus?
  newStatus      CartRequestStatus?
  authorId       String?
  author         User?                @relation("EventAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())

  @@index([cartRequestId])
}
