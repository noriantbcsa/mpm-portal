# Copia este archivo a ".env" y ajusta los valores para tu entorno.

# --- Base de datos ---------------------------------------------------------
# Cadena de conexión PostgreSQL. El docker-compose.yml incluido levanta una
# instancia local en el puerto 5544 con estas mismas credenciales de ejemplo.
DATABASE_URL="postgresql://mpm:mpm_dev_password@localhost:5544/mpm_portal?schema=public"

# --- Autenticación ----------------------------------------------------------
# Clave para firmar las sesiones (JWT) del panel administrativo.
# Genera una nueva con: openssl rand -base64 32
AUTH_SECRET="reemplaza-esta-clave-con-openssl-rand--base64-32"

# Clave estable para cifrar referencias de Server Actions si se despliega en
# más de una instancia. Genera otra con: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="reemplaza-esta-clave-con-openssl-rand--base64-32"

# --- Cloudinary (gestión de imágenes) --------------------------------------
# Deja estos valores vacíos mientras no exista la cuenta definitiva: el portal
# sigue funcionando con las URLs de imagen que se guarden manualmente.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- WhatsApp Business ------------------------------------------------------
# Número en formato internacional sin "+" ni espacios (ej: 573001234567).
# Este valor es el respaldo si no hay configuración guardada en el panel.
NEXT_PUBLIC_WHATSAPP_NUMBER="573000000000"

# --- Sitio -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
