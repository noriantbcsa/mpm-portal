# Copia este archivo a ".env" y ajusta los valores para tu entorno.

# --- Base de datos ---------------------------------------------------------
# Cadena de conexión PostgreSQL. El docker-compose.yml incluido levanta una
# instancia local en el puerto 5544 con estas mismas credenciales de ejemplo.
DATABASE_URL="postgresql://mpm:mpm_dev_password@localhost:5544/mpm_portal?schema=public"

# --- Autenticación ----------------------------------------------------------
# Clave para firmar las sesiones (JWT) del panel administrativo.
# Genera una nueva con: openssl rand -base64 32
AUTH_SECRET="reemplaza-esta-clave-con-openssl-rand--base64-32"

# Clave estable para cifrar referencias de Server Actions si se despliega en
# más de una instancia. Debe ser base64 válido de 16, 24 o 32 bytes: genérala
# con `openssl rand -base64 32`. No pongas un texto de relleno (Next lo
# decodifica sin validarlo). En desarrollo no hace falta.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Máximo de conexiones del pool de Prisma (por defecto 5, pensado para el plan
# gratuito de la base de datos de Render).
# DATABASE_POOL_MAX="5"

# --- WhatsApp ---------------------------------------------------------------
# El número que ve el público se administra desde /admin/ajustes (no hay
# variable de entorno para esto).

# --- Sitio -------------------------------------------------------------------
# Dominio público real en producción: se usa en URLs canónicas, sitemap y
# robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Pruebas y comprobaciones de migraciones -------------------------------
# Base de pruebas para `npm run test:integration` (sin ella, esas pruebas se
# omiten). La que crea docker-compose.yml usa el puerto 5544.
# TEST_DATABASE_URL="postgresql://mpm:mpm_dev_password@localhost:5544/mpm_portal_test?schema=public"
# Base desechable vacía para `npm run db:drift` (compara migraciones y esquema).
# SHADOW_DATABASE_URL="postgresql://mpm:mpm_dev_password@localhost:5544/mpm_portal_shadow?schema=public"

# --- Seed (solo `npm run db:seed` contra una base NO local) -----------------
# Contraseña del administrador inicial. Sin ella, el seed no crea cuentas
# fuera de la base local de Docker. Mínimo 10 caracteres.
# SEED_ADMIN_PASSWORD=""
